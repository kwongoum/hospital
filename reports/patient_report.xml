<odoo>

    <template id="patient_report_template">

        <t t-call="web.html_container">

            <div class="page">

                <h2>Patient Report</h2>

                <t t-foreach="docs" t-as="o">

                    <p>
                        <strong>Reference:</strong>
                        <span t-field="o.ref_patient_sequence" />
                    </p>

                    <p>
                        <strong>Name:</strong>
                        <span t-field="o.name" />
                    </p>

                    <p>
                        <strong>Date of Birth:</strong>
                        <span t-field="o.date_of_birth" />
                    </p>

                    <p>
                        <strong>Gender:</strong>
                        <span t-field="o.gender" />
                    </p>

                    <p>
                        <strong>Age:</strong>
                        <span t-field="o.age" />
                    </p>

                </t>

            </div>

        </t>

    </template>


    <record id="action_patient_report" model="ir.actions.report">

        <field name="name">Patient Report</field>

        <field name="model">hospital.patient</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">hospital.patient_report_template</field>

        <field name="report_file">hospital.patient_report_template</field>

        <field name="binding_model_id"
            ref="model_hospital_patient" />

        <field name="binding_type">report</field>

    </record>

</odoo>