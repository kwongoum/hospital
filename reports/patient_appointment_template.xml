<odoo>
    <template id="patient_appointment_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center"> Patient Appointment Report </h2>

                        <!-- Patient information -->
                        <h3>Patient Information</h3>
                        <table class="table table-bordered">
                            <tr>
                                <td>
                                    <strong>Name</strong>
                                </td>
                                <td>
                                    <span t-field="o.name" />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Age</strong>
                                </td>
                                <td>
                                    <span t-field="o.age" />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Reference</strong>
                                </td>
                                <td>
                                    <span t-field="o.ref_patient_sequence" />
                                </td>
                            </tr>
                        </table>

                        <!-- Selected period -->
                        <h3>Report Period</h3>
                        <p>
                            <strong>From: </strong>
                            <span t-esc="date_from" />
                            <strong> To: </strong>
                            <span t-esc="date_to" />
                        </p>

                        <!-- Filtered patient appointments -->
                        <h3>Appointments</h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Date</th>
                                    <th>Doctor</th>
                                    <th>State</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="appointments" t-as="appointment">
                                    <td>
                                        <span t-field="appointment.ref_appointment" />
                                    </td>
                                    <td>
                                        <span t-field="appointment.appointment_date" />
                                    </td>
                                    <td>
                                        <span t-field="appointment.doctor_id" />
                                    </td>
                                    <td>
                                        <span t-field="appointment.state" />
                                    </td>
                                </tr>

                                <tr t-if="not appointments">
                                    <td colspan="4" class="text-center">
                                        No appointments found for this period.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>