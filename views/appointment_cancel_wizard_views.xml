<odoo>


    <record id="view_appointment_cancel_wizard_form" model="ir.ui.view">
        <field name="name">appointment.cancel.wizard.form</field>
        <field name="model">appointment.cancel.wizard</field>

        <field name="arch" type="xml">
            <!-- <form string="Appointment Form" edit="0" delete="0"> -->
            <form string="Appointment Cancel Form">

                <sheet>
                    <group>
                        <field name="appointment_id" default_focus="1" />
                        <field name="reason" />
                    </group>
                </sheet>
                <footer>
                    <button name="discard" special="cancel"
                        string="Discard"
                        class="btn-secondary" />

                    <button name="action_cancel"
                        string="Yes Cancel"
                        type="object"
                        class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>


    <record id="action_appointment_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Appointment Cancel Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">appointment.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_appointment_cancel_wizard_form" />
    </record>

</odoo>