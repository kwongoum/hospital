<odoo>

    <record id="view_move_form_hospital" model="ir.ui.view">
        <field name="name">account.move.form.hospital</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="confirmed_user_id" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='product_id']"
                position="before">
                <field name="line_number" />
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']"
                position="before">
                <field name="line_number" />
            </xpath>


            <xpath expr="//field[@name='line_ids']/tree//field[@name='account_id']"
                position="before">
                <field name="line_number" invisible="1" />
            </xpath>
        </field>
    </record>

</odoo>