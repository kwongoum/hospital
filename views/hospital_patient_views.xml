<odoo>

    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patients">
                <field name="name" />
                <field name="age" />
                <separator />
                <filter string="Female" name="patient_female"
                    domain="[('gender', '=', 'female')]" />
                <separator />
                <filter string="Child" name="patient_child" domain="[('age','&lt;', 7)]"
                />
                <filter name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group expand="1" string="Group By">
                    <filter string="Gender" name='group_by_gender'
                        context="{'group_by':'gender'}" />
                    <filter string="Age" name='group_by_age'
                        context="{'group_by':'age'}" />
                </group>
                <searchpanel>
                    <field name="gender" string="Gender" enable_counters="1" icon="fa-users"
                        select="multi" />
                </searchpanel>
            </search>
        </field>
    </record>


    <record id="view_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hospital.patient.tree</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <tree string="Patient Tree" sample="1" export_xlsx="0">
                <field name="name" />
                <field name="address" />
                <field name="gender" />
                <field name="appointment_count" sum="Total Appointments" />
                <field name="ref_patient" />
                <field name="ref_patient_sequence" />
                <field name="active" />
            </tree>
        </field>
    </record>


    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>

        <field name="arch" type="xml">
            <form string="Patient Form">
                <div class="alert alert-info" text-align="center" role="alert"
                    attrs="{'invisible': [('is_birthday', '=', False)]}">
                    <a class="close" data-dismiss="alert" href="#" aria-label="Close">
                        close</a>
                    <strong>Happy Birthday <field
                            name="name"></field> !</strong> Wishing you a day filled with happiness
                    and a year filled with joy. </div>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments"
                            type="object" class="oe_stat_button"
                            icon="fa-star">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="appointment_count" />
                                </span>
                                <span class="o_stat_text">
                                    Appointments
                                </span>
                            </div>
                        </button>
                    </div>


                    <field name="image_1920" widget="image" class="oe_avatar"
                        options="{'preview_image' : 'image_1920'}" />
                    <div class="oe_title">
                        <h2>
                            <label for="name" string="Name" />
                            <field name="name" autofocus="1" />
                        </h2>
                    </div>
                    <group>
                        <group>

                            <field name="date_of_birth" />
                            <field name="age" />
                            <field name="ref_patient" />
                            <field name="ref_patient_sequence" readonly=" 1" />
                            <field name="email" widget="email" />
                            <field name="phone" widget="phone" />
                            <field name="website" widget="url" />
                            <field name="code" widget="ace" options="{'mode' : 'python' }" />

                            <field name="is_birthday" invisible="1" />
                        </group>
                        <group>
                            <field name="gender" widget="radio" options=" {'horizontal':true}"
                                invisible=" context.get('hide_gender' )=='female'" />
                            <field name="address" />
                            <field name="active"
                                help="Inactive patients will not appear in
                            lists" />
                            <field name="is_covered" widget="boolean_toggle" />
                            <field name="tag_ids" widget="many2many_tags"
                                options="{'color_field':'color'}" />
                            <field name="appointment_count" />
                        </group>
                    </group>
                    <group string="Additional Information" cols="2">
                        <field name="parent_phone"
                            attrs="{'invisible': [('age', '>', 18),('gender','=','male')]}" />
                        <field
                            name="marital_status" attrs="{'invisible': [('age', '&lt;', 18)]}" />
                        <field
                            name="spouse_name"
                            attrs="{'invisible': [('marital_status', '!=', 'married')],
                                'required': [('marital_status', '=', 'married')]
                                }" />
                    </group>

                </sheet>
                <!-- CHATTTER -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids" widget="mail_activity" />
                </div>
            </form>
        </field>
    </record>

    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients list_ac</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="view_id" ref="view_hospital_patient_tree" />

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first patient!
            </p>
        </field>
        <field name="context">
            {
            'search_default_patient_male':1,
            'search_default_group_by_gender': 1
            }
        </field>

        <field name="search_view_id" ref="view_hospital_patient_search" />
    </record>

    <record id="action_hospital_patient_kanban" model="ir.actions.act_window">
        <field name="name">Patients_kanban_ac</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain"> [('gender','!=','male'),('gender','!=','female')]</field>
    </record>

</odoo>