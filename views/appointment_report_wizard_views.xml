<odoo>

    <record id="view_appointment_report_wizard_form" model="ir.ui.view">
        <field name="name">appointment.report.wizard.form</field>
        <field name="model">appointment.report.wizard</field>

        <field name="arch" type="xml">
            <!-- <form string="Appointment Form" edit="0" delete="0"> -->
            <form string="Appointment Report Form">
                <sheet>
                    <group>
                        <field name="patient_id" />
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                </sheet>

                <footer>
                    <button name="discard" special="cancel"
                        string="Discard"
                        class="btn-secondary" />

                    <button name="action_print_report"
                        string="Generate Report"
                        type="object"
                        class="btn-primary" />

                    <button name="action_print_xlsx_report"
                        string="Generate XLSX Report"
                        type="object"
                        class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_appointment_report_wizard" model="ir.actions.act_window">
        <field name="name">Appointment Report Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">appointment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_appointment_report_wizard_form" />
    </record>

</odoo>